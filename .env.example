VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local MSSQL Backend Configuration
# Create a .env.local file with these variables

# Server Port (default: 4110)
SERVER_PORT=4110

# MSSQL Database Connection
DB_HOST=PC-CP\SWOT2019
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=SWOT.sql2019
DB_DATABASE=slide_builder

# MSSQL Connection Options
# Set to 'true' for local development with self-signed certificates
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Connection Pool Size (default: 10)
DB_POOL_SIZE=10

# CORS Origin (default: * for development)
CORS_ORIGIN=*

# Node Environment (development|production)
NODE_ENV=development
